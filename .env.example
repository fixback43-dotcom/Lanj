# Connection string Postgres dari Neon (Settings > Connection Details)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Generate acak, JANGAN pakai contoh ini:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter

PORT=3001

# Domain frontend yang boleh akses API ini, pisahkan koma kalau lebih dari satu.
# Contoh: https://study-planner.vercel.app,https://nexa-study.pages.dev
ALLOWED_ORIGINS=

# Set "false" hanya kalau Postgres-mu tidak butuh SSL (jarang, biasanya untuk lokal).
PGSSL=true
