# ============================================================
# ISI SEMUA "<< ... >>" DI BAWAH SEBELUM JALANIN APLIKASI.
# Rename file ini jadi ".env" (buang "nexa-pay." di depannya)
# setelah semua terisi, taruh di root folder nexa-pay/.
# ============================================================

# ============================================================
# DATABASE
# ============================================================
# Dashboard Neon > project > Connection Details > TOGGLE "Pooled connection"
# WAJIB pakai yang pooled (ada "-pooler" di hostname), bukan yang direct —
# karena Netlify serverless functions bisa buka banyak koneksi bersamaan,
# tanpa pooling bisa langsung habisin connection limit Postgres.
# Contoh format: postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_h5zr0SbAWyUq@ep-sparkling-wind-ao8uma2a.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ============================================================
# AUTH
# ============================================================
# Sudah di-generate otomatis, aman langsung dipakai — TAPI kalau
# string ini pernah kelihatan orang lain (screenshot, dll), generate
# ulang sendiri pakai:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=984f3f371437f6ac4cbf395e7bf21356a68d08fbb4efa0e175ca3179fa56f299

# ============================================================
# STSPOINT API — https://docs.stspoint.id
# Console STSPoint > Developer > API Keys
# ============================================================
STS_SECRET_KEY=<<ISI_SECRET_KEY_DARI_CONSOLE_STSPOINT>>
STS_MERCHANT_ID=<<ISI_MERCHANT_ID_DARI_CONSOLE_STSPOINT>>

# Console STSPoint > Webhooks (bisa beda dari Secret Key di atas).
# Kalau kosong, verifikasi otomatis fallback pakai STS_SECRET_KEY.
STS_WEBHOOK_SECRET=<<ISI_WEBHOOK_SECRET_ATAU_KOSONGKAN>>

# KOSONGKAN DULU saat pertama kali deploy — Netlify belum kasih URL.
# Isi SETELAH deploy pertama sukses, formatnya:
# https://nama-site-lu.netlify.app/api/webhook/stspoint
# Lalu WAJIB trigger redeploy manual di Netlify (env var baru tidak
# otomatis kepake tanpa redeploy).
STS_CALLBACK_URL=

# Boleh dibiarkan default
STS_SYNTHETIC_EMAIL_DOMAIN=nexapay.local
